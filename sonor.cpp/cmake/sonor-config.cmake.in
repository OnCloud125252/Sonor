set(SONOR_VERSION      @SONOR_INSTALL_VERSION@)
set(SONOR_BUILD_COMMIT @SONOR_BUILD_COMMIT@)
set(SONOR_BUILD_NUMBER @SONOR_BUILD_NUMBER@)
set(SONOR_SHARED_LIB   @BUILD_SHARED_LIBS@)

@PACKAGE_INIT@

set_and_check(SONOR_INCLUDE_DIR "@PACKAGE_SONOR_INCLUDE_INSTALL_DIR@")
set_and_check(SONOR_LIB_DIR     "@PACKAGE_SONOR_LIB_INSTALL_DIR@")
set_and_check(SONOR_BIN_DIR     "@PACKAGE_SONOR_BIN_INSTALL_DIR@")

find_package(ggml REQUIRED HINTS ${LLAMA_LIB_DIR}/cmake)

find_library(sonor_LIBRARY sonor
    REQUIRED
    HINTS ${SONOR_LIB_DIR}
    NO_CMAKE_FIND_ROOT_PATH
)

add_library(sonor UNKNOWN IMPORTED)
set_target_properties(sonor
    PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${SONOR_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "ggml::ggml;ggml::ggml-base;"
        IMPORTED_LINK_INTERFACE_LANGUAGES "CXX"
        IMPORTED_LOCATION "${sonor_LIBRARY}"
        INTERFACE_COMPILE_FEATURES cxx_std_11
        POSITION_INDEPENDENT_CODE ON )

check_required_components(sonor)
